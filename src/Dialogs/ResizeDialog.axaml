<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Chitin.ResizeDialog"
        Title="Resize Document"
        Width="378"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Icon="/assets/app.ico">
  <StackPanel Margin="12" Spacing="10">
    <TextBlock Text="Dimensions" FontWeight="Bold" />
    <TextBlock Text="Width and height must be between 1 and 8192 pixels." FontSize="11" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBox x:Name="WidthBox" Width="100" AutomationProperties.Name="Document width" />
      <TextBlock Text=" X " VerticalAlignment="Center" />
      <TextBox x:Name="HeightBox" Width="100" AutomationProperties.Name="Document height" />
    </StackPanel>
    <TextBlock x:Name="ValidationText" Foreground="#FFCC4444" TextWrapping="Wrap" IsVisible="False" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="OkButton" Content="OK" Width="75" IsDefault="True" Click="Ok_Click" />
      <Button Content="Cancel" Width="75" IsCancel="True" Click="Cancel_Click" />
    </StackPanel>
  </StackPanel>
</Window>
