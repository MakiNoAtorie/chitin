<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Chitin.ResizeDialog"
        Title="Resize Document"
        Width="378"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Icon="/assets/app.ico">
  <StackPanel Margin="12" Spacing="10">
    <TextBlock Text="Size in pixels" FontWeight="Bold" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <NumericUpDown x:Name="WidthBox" Width="130" Minimum="1" Maximum="8192" Increment="1"
                     FormatString="0" AutomationProperties.Name="Document width" />
      <TextBlock Text="×" VerticalAlignment="Center" />
      <NumericUpDown x:Name="HeightBox" Width="130" Minimum="1" Maximum="8192" Increment="1"
                     FormatString="0" AutomationProperties.Name="Document height" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Resize" Width="90" IsDefault="True" Click="Ok_Click" />
      <Button Content="Cancel" Width="90" IsCancel="True" Click="Cancel_Click" />
    </StackPanel>
  </StackPanel>
</Window>
