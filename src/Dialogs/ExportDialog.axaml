<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Chitin.ExportDialog"
        Title="Export"
        Width="430"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Icon="/assets/app.ico">
  <StackPanel Margin="12" Spacing="10">
    <TextBlock Text="Format" FontWeight="Bold" />
    <StackPanel Orientation="Horizontal" Spacing="16">
      <RadioButton x:Name="PngRadio" GroupName="Format" Content="PNG" IsChecked="True" />
      <RadioButton x:Name="SvgRadio" GroupName="Format" Content="SVG" />
    </StackPanel>
    <TextBlock Text="Size" FontWeight="Bold" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="Width" VerticalAlignment="Center" />
      <NumericUpDown x:Name="WidthBox" Width="130" Minimum="1" Maximum="8192" Increment="1"
                     FormatString="0" AutomationProperties.Name="Export width" />
      <TextBlock Text="Height" VerticalAlignment="Center" />
      <NumericUpDown x:Name="HeightBox" Width="130" Minimum="1" Maximum="8192" Increment="1"
                     FormatString="0" AutomationProperties.Name="Export height" />
    </StackPanel>
    <CheckBox x:Name="TransparentBox" Content="Transparent background (PNG only)" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Export" Width="90" IsDefault="True" Click="Ok_Click" />
      <Button Content="Cancel" Width="90" IsCancel="True" Click="Cancel_Click" />
    </StackPanel>
  </StackPanel>
</Window>
