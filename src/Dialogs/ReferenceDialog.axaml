<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Chitin.ReferenceDialog"
        Title="Reference Image"
        Width="470"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Icon="/assets/app.ico">
  <StackPanel Margin="12" Spacing="10">
    <TextBlock Text="Opacity" FontWeight="Bold" />
    <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" TickFrequency="10"
            IsSnapToTickEnabled="True" AutomationProperties.Name="Reference opacity" />
    <TextBlock Text="Scale" FontWeight="Bold" />
    <Slider x:Name="ScaleSlider" Minimum="25" Maximum="400" TickFrequency="5"
            IsSnapToTickEnabled="True" AutomationProperties.Name="Reference scale" />
    <StackPanel Orientation="Horizontal" Spacing="16">
      <CheckBox x:Name="FlipHBox" Content="Flip horizontal" />
      <CheckBox x:Name="FlipVBox" Content="Flip vertical" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="Offset X" VerticalAlignment="Center" />
      <NumericUpDown x:Name="OffsetXBox" Width="130" Increment="1" FormatString="0.###"
                     AutomationProperties.Name="Reference offset X" />
      <TextBlock Text="Offset Y" VerticalAlignment="Center" />
      <NumericUpDown x:Name="OffsetYBox" Width="130" Increment="1" FormatString="0.###"
                     AutomationProperties.Name="Reference offset Y" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Fit to Plane" Width="100" Click="Fit_Click" />
      <Button Content="Reset" Width="80" Click="Reset_Click" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="OK" Width="75" IsDefault="True" Click="Ok_Click" />
      <Button Content="Cancel" Width="75" IsCancel="True" Click="Cancel_Click" />
    </StackPanel>
  </StackPanel>
</Window>
