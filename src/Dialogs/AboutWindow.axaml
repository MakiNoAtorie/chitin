<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Chitin.AboutWindow"
        Title="About Chitin"
        Width="300"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Icon="/assets/app.ico">
  <StackPanel Margin="24" Spacing="10">
    <TextBlock Text="Chitin" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
    <TextBlock Text="A port of Epic Games' Carapace V1.0" HorizontalAlignment="Center" />
    <TextBlock TextWrapping="Wrap" TextAlignment="Center"
               Text="A perspective-drawing aid. Have questions, comments or suggestions? Join the discussion at:" />
    <HyperlinkButton Content="http://epic.gm/carapace"
                     NavigateUri="http://epic.gm/carapace"
                     HorizontalAlignment="Center" />
    <Separator />
    <HyperlinkButton Content="www.epicgames.com"
                     NavigateUri="https://www.epicgames.com"
                     HorizontalAlignment="Center" />
    <Separator />
    <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold"
               Text="Stuck? Close this dialog and press F1 to see a list of hot keys and descriptions." />
    <Button Content="OK" Width="75" HorizontalAlignment="Center" IsDefault="True" IsCancel="True" Click="Ok_Click" />
  </StackPanel>
</Window>
