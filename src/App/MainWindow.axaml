<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Chitin"
        x:Class="Chitin.MainWindow"
        Title="Chitin"
        Width="1084"
        Height="812"
        WindowStartupLocation="CenterScreen"
        Icon="/assets/app.ico"
        Background="{DynamicResource Paper}"
        Foreground="{DynamicResource Ink}"
        FontSize="12"
        KeyDown="Window_KeyDown">
  <!-- Brushes are replaced from the active palette (MainWindow.ApplyTheme). -->
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#111111" />
    <SolidColorBrush x:Key="Paper" Color="#F7F7F4" />
    <SolidColorBrush x:Key="Hair" Color="#B7B7B5" />
    <SolidColorBrush x:Key="Prompt" Color="#B07A2E" />
  </Window.Resources>
  <Window.Styles>
    <Style Selector="TextBlock.caps">
      <Setter Property="FontSize" Value="9" />
      <Setter Property="LetterSpacing" Value="1.2" />
    </Style>
    <!-- Flat cells: no rounding; hover shows a hairline fill, the on state inverts ink and paper. -->
    <Style Selector="Button.cell">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hair}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.cell:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hair}" />
    </Style>
    <Style Selector="Button.cell.on">
      <Setter Property="Background" Value="{DynamicResource Ink}" />
      <Setter Property="Foreground" Value="{DynamicResource Paper}" />
    </Style>
    <Style Selector="TextBox.coord">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="4,1" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
  </Window.Styles>

  <Grid x:Name="Frame" RowDefinitions="Auto,20,*,28" ColumnDefinitions="40,20,*,Auto">
    <Border Grid.ColumnSpan="4" BorderBrush="{DynamicResource Ink}" BorderThickness="0,0,0,1">
      <Menu x:Name="MainMenu" Background="Transparent" Closed="Menu_Closed" />
    </Border>

    <!-- Tool tray: one lettered cell per tool, the active one inverted. -->
    <Border Grid.Row="1" Grid.RowSpan="2" BorderBrush="{DynamicResource Ink}" BorderThickness="0,0,1,0">
      <StackPanel x:Name="TrayPanel" />
    </Border>

    <Border Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource Ink}" BorderThickness="0,0,1,1" />
    <local:Ruler x:Name="TopRuler" Grid.Row="1" Grid.Column="2" />
    <local:Ruler x:Name="LeftRuler" Grid.Row="2" Grid.Column="1" Vertical="True" />
    <local:ViewportControl x:Name="Viewport" Grid.Row="2" Grid.Column="2"
                           ClipToBounds="True" AutomationProperties.Name="Drawing viewport" />

    <!-- Find (Ctrl+F): a field and the matching commands over the top of the viewport. -->
    <Border x:Name="FindOverlay" Grid.Row="2" Grid.Column="2" IsVisible="False" ZIndex="1"
            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" Width="440"
            Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Ink}" BorderThickness="2">
      <DockPanel>
        <TextBox x:Name="FindBox" DockPanel.Dock="Top" Watermark="Find a command" BorderThickness="0,0,0,1"
                 AutomationProperties.Name="Find a command" />
        <ScrollViewer x:Name="FindScroll" MaxHeight="320">
          <StackPanel x:Name="FindList" />
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Points panel (Ctrl+K hides it): one row per placed point, position typed in place. -->
    <Border x:Name="PointsPanel" Grid.Row="1" Grid.RowSpan="2" Grid.Column="3" Width="252"
            BorderBrush="{DynamicResource Ink}" BorderThickness="1,0,0,0">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Points">
        <StackPanel x:Name="PointsList" />
      </ScrollViewer>
    </Border>

    <!-- Foot: the tool hint and the last prompt or error on the left, readouts on the right. -->
    <Border Grid.Row="3" Grid.ColumnSpan="4" BorderBrush="{DynamicResource Ink}" BorderThickness="0,1,0,0">
      <DockPanel Margin="10,0,0,0">
        <Button x:Name="ZoomButton" DockPanel.Dock="Right" Classes="cell" Padding="10,0" Width="70"
                HorizontalContentAlignment="Center" BorderThickness="1,0,0,0"
                ToolTip.Tip="Fit the plane in view (Home)" AutomationProperties.Name="Zoom; fit the plane">
          <TextBlock x:Name="ZoomText" FontWeight="Bold" />
        </Button>
        <TextBlock x:Name="Readout" DockPanel.Dock="Right" Margin="12,0" VerticalAlignment="Center" />
        <Border x:Name="MessageMark" DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,6,0"
                Background="{DynamicResource Prompt}" IsVisible="False" />
        <TextBlock x:Name="Message" DockPanel.Dock="Left" Margin="0,0,16,0" VerticalAlignment="Center" />
        <TextBlock x:Name="Hint" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource Ink}" Opacity="0.8" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
